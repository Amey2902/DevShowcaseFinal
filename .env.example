# ── Copy this to .env and fill in your values ──────────────────────────────
# Generate SECRET_KEY at: https://djecrety.ir/
SECRET_KEY=your-django-secret-key-here

# PostgreSQL password (choose any strong password)
DB_PASSWORD=choose-a-strong-password

# Groq AI
GROQ_API_KEY=your-groq-api-key-here

# Gmail SMTP (for magic link emails)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# Your EC2 public IP or domain (used in magic link emails)
FRONTEND_URL=http://your-ec2-ip-or-domain
